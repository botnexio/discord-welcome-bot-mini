# Copy to .env and fill in. Never commit .env.
# Bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=
# Channel ID for welcome messages (Developer Mode -> right-click channel -> Copy ID)
WELCOME_CHANNEL_ID=
# Optional: role ID given to every new member (leave empty to disable)
AUTO_ROLE_ID=
# Optional: message text. Placeholders: {user} (mention), {username}, {server}, {memberCount}
# Empty = default "Welcome {user} to {server}!"
WELCOME_MESSAGE=
# Optional: embed title. Empty = default "Welcome!"
WELCOME_TITLE=
# Optional: embed color as hex, e.g. #5865F2. Empty = default #5865F2
WELCOME_COLOR=
# Optional: server ID to register /ping and /help instantly there (otherwise global, can take a while)
GUILD_ID=
